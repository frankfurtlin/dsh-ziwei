{
  "name": "dsh-ziwei",
  "version": "0.1.0",
  "private": true,
  "description": "紫微斗数 DSH 插件：侧栏「插件 → 自动化任务 → 紫微斗数」入口，主面板内嵌本地排盘应用（同源反向代理，仅 DSH 登录用户可访问），一键把盘面交给 DSH Agent 解读。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "verify.mjs",
    "README.md"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check client.js",
    "verify": "node verify.mjs",
    "self-check": "bash scripts/check.sh",
    "self-check:static": "bash scripts/check.sh --static",
    "hooks": "bash scripts/install-hooks.sh"
  }
}
